    -1, OpTypes::i8imm, -1, OpTypes::i32imm, OpTypes::SEGMENT_REG, 
    -1, OpTypes::i8imm, -1, OpTypes::i32imm, OpTypes::SEGMENT_REG, 
    -1, OpTypes::i8imm, -1, OpTypes::i32imm, OpTypes::SEGMENT_REG, 
    -1, OpTypes::i8imm, -1, OpTypes::i32imm, OpTypes::SEGMENT_REG, 
    -1, OpTypes::i8imm, -1, OpTypes::i32imm, OpTypes::SEGMENT_REG, 
  };
  return OpcodeOperandTypes[Offsets[Opcode] + OpIdx];
}
